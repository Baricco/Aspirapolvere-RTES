#!/bin/sh
# Lanciato da /etc/init.d/rtes-wifi solo all'avvio. Se entro WAIT_S secondi wlan0 non ha un indirizzo IPv4, ferma il
# nostro Wi-Fi e avvia il wifiManager di fabbrica, così il robot resta raggiungibile in SSH.
# Resoconto in LOG (in RAM, riscritto a ogni avvio).

PATH=/usr/sbin:/usr/bin:/sbin:/bin
WAIT_S=60
LOG=/tmp/rtes-wifi-check.log

exec >"$LOG" 2>&1
echo "inizio: $(cat /proc/uptime | cut -d' ' -f1) s dall'accensione"

i=0
while [ $i -lt $WAIT_S ]; do
    if /sbin/ip -4 addr show wlan0 2>/dev/null | grep -q inet; then
        echo "ok: wlan0 ha un indirizzo dopo ~$i s"
        /sbin/ip -4 addr show wlan0
        exit 0
    fi
    [ $((i % 5)) -eq 0 ] && echo "$(cut -d' ' -f1 /proc/uptime) s: udhcpc=[$(pidof udhcpc)] wpa=[$(pidof wpa_supplicant)] $(/sbin/ip -4 addr show wlan0 | grep inet)"
    sleep 1
    i=$((i + 1))
done

echo "wlan0 senza indirizzo dopo $WAIT_S s: avvio il wifiManager di fabbrica"
/sbin/ip addr show wlan0
echo "processi: wpa=$(pidof wpa_supplicant) udhcpc=$(pidof udhcpc)"
logread | grep -E "udhcpc|wpa_supplicant|netifd" | tail -20
/etc/init.d/rtes-wifi stop
/etc/init.d/robotWifiManager start
