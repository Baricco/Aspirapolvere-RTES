#!/bin/sh /etc/rc.common
# Wi-Fi del robot (docs/wifi.md): rtes-wifi gestisce wpa_supplicant, udhcpc, la rete del robot (hostapd, dnsmasq) e il
# cambio di rete dall'app. Lo lancia rtes-wifi-run, che se rtes-wifi si chiude troppe volte avvia il wifiManager di
# fabbrica, perché SSH via Wi-Fi è l'unico modo per entrare nel robot.
# Il chip lo accende il kernel all'avvio e il modulo lo carica /etc/modules.d (net-rtl8189es); qui lo si carica solo
# se manca.

START=21
STOP=99
USE_PROCD=1

WIFI_MODULE=/lib/modules/3.4.39/8189es.ko
WLAN_WAIT_S=10        # attesa massima della comparsa di wlan0 dopo il caricamento del modulo

start_service() {
    if [ ! -d /sys/class/net/wlan0 ]; then
        insmod "$WIFI_MODULE"
        i=0
        while [ ! -d /sys/class/net/wlan0 ] && [ $i -lt $WLAN_WAIT_S ]; do
            sleep 1
            i=$((i + 1))
        done
    fi
    ifconfig wlan0 up

    # rtes-wifi-run rilancia da solo rtes-wifi; procd fa ripartire rtes-wifi-run se si chiude lui
    procd_open_instance
    procd_set_param command /usr/sbin/rtes-wifi-run
    procd_set_param oom_adj -17
    # uscita di rtes-wifi e dei suoi processi nel registro: logread -e rtes-wifi
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 3600 5 0
    procd_close_instance
}

stop_service() {
    ifconfig wlan0 down
}
