# Fase 2, blocco C3: spazzole e aspirazione, per trovare le correnti nel frame dei sensori e i valori ammessi.
# SOLO CON IL ROBOT SOLLEVATO (--sollevato). Valori dei log originali: spazzola centrale 60, setBlowerPwmBattery 88.
# Uso: tools/banco-robot.sh avvia c3 --sollevato --sequenza tools/sequenze/c3-spazzole-aspirazione.seq --tensione-minima 140
0      0x6a:i8=30       # spazzola centrale (packetRollingSpeed)
3000   0x6a:i8=60
6000   0x6a:i8=0
7000   0x69:i8=30       # spazzola laterale (packetBrushSpeed)
10000  0x69:i8=60
13000  0x69:i8=0
14000  0x86:u8=40       # aspirazione, PWM compensato con la tensione (packetBlowerPwmBattery)
17000  0x86:u8=88
20000  0x86:u8=0
21000  0x85:u8=40       # aspirazione, PWM puro (packetBlowerPwmOnly)
24000  0x85:u8=0
25000  0x68:i16=1000    # aspirazione, velocità/10 (packetBlowerSpeed)
28000  0x68:i16=0
29000  0x6a:i8=-30      # spazzola centrale al contrario
31000  0x6a:i8=0
32000  fine
