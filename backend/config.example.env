# Esempio del file .env del backend, con valori finti. Copialo in backend/.env (che git ignora) e cambia i valori.
# In produzione le stesse variabili stanno nell'unità systemd (deploy/maurice-backend.service).

# cartella dei dati, fuori dal progetto: database, mappe, chiave del JWT, ultimo stato, scia
MAURICE_DATA_DIR=/percorso/della/cartella/dei/dati

# solo in sviluppo: origini da cui gira l'app web quando non è servita dallo stesso indirizzo del backend
MAURICE_ALLOWED_ORIGINS=http://localhost:8090
